def verify_password_for_withdraw(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    user_id = update.effective_user.id
    if is_blocked_db(user_id): show_blocked_message(update, context); return ConversationHandler.END

    agent_code = context.user_data.get('agent_code')

    # 1. Check Pending on Agent Code
    if agent_code and is_code_pending(agent_code):
        reply_and_delete(update, context, get_text(user_id, 'pending_req'))
        return cancel_and_show_menu(update, context)

    # 2. Check 24-Hour Limit
    if agent_code:
        last_time = get_last_approved_time(agent_code)
        if int(time.time()) - last_time < 86400:
            reply_and_delete(update, context, get_text(user_id, 'limit_reached'))
            return cancel_and_show_menu(update, context)

    # Password Check
    if update.message.text.strip() != context.user_data['saved_password']:
        reply_and_delete(update, context, get_text(user_id, 'wrong_pass'))
        return cancel_and_show_menu(update, context)
    
    row = context.user_data['row']
    user_sheet.update_cell(row, USER_ID_COL, user_id)
    details = user_sheet.row_values(row)
    balance = float((details[BALANCE_COL - 1] if len(details) >= BALANCE_COL else "0").replace(',', ''))
    
    if balance < 50:
        reply_and_delete(update, context, get_text(user_id, 'min_withdraw'))
        return cancel_and_show_menu(update, context)
    
    context.user_data.update({'w_code': agent_code, 'w_bal': balance, 'w_details': details})
    
    # Method Selection
    keyboard = [
        [InlineKeyboardButton("💳 Bkash/বিকাশ", callback_data="w_Bkash")],
        [InlineKeyboardButton("💳 Nagad/নগদ", callback_data="w_Nagad")],
        [InlineKeyboardButton("🚀 Rocket/রকেট", callback_data="w_Rocket")],
        [InlineKeyboardButton("🏦 Binance", callback_data="w_Binance")]
    ]
    reply_and_delete(update, context, get_text(user_id, 'payment_method_prompt'), reply_markup=InlineKeyboardMarkup(keyboard))
    return CHOOSE_METHOD

def withdraw_choose_method(update: Update, context: CallbackContext):
    query = update.callback_query; user_id = query.from_user.id
    query.answer()
    
    _, method = query.data.split('_')
    if not is_method_active(method):
        reply_and_delete(query, context, "⚠️ Method maintenance/off.")
        return CHOOSE_METHOD

    context.user_data['w_method'] = method
    schedule_message_deletion(context, query.message, user_id)
    
    # Auto-fill number if exists
    col_map = {'Bkash': BKASH_COL, 'Nagad': NAGAD_COL, 'Binance': BINANCE_COL}
    saved_num = ""
    if method in col_map:
        idx = col_map[method] - 1
        details = context.user_data['w_details']
        saved_num = details[idx].strip("'") if len(details) > idx else ""

    if saved_num:
        context.user_data['w_num'] = saved_num
        kb = [[InlineKeyboardButton(f"✅ {saved_num}", callback_data="use_saved")], 
              [InlineKeyboardButton("✏️ Change", callback_data="change_num")]]
        reply_and_delete(query, context, f"Use saved {method}?", reply_markup=InlineKeyboardMarkup(kb))
        return ASK_AMOUNT
    else:
        reply_and_delete(query, context, f"Enter {method} Number/ID:", reply_markup=BACK_KEYBOARD)
        return GET_TEMP_NUMBER

