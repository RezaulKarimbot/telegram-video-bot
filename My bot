    except Exception as e: logger.error(f"get_chat_member error: {e}"); query.answer("⚠️ Error checking verification.", show_alert=True)

def find_cell_robust(query, in_column, sheet_obj=user_sheet):
    try:
        values = sheet_obj.col_values(in_column, value_render_option='FORMATTED_VALUE')
        cleaned_values = [val.strip("'") for val in values]
        if query in cleaned_values:
            row = cleaned_values.index(query) + 1
            return gspread.Cell(row, in_column, value=query)
        else:
            return None
    except Exception as e:
        logger.error(f"Error in find_cell_robust: {e}")
        return None

def get_password_and_proceed(update: Update, context: CallbackContext, next_state):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    agent_code = update.message.text.strip()
    user_id = update.message.from_user.id
    
    if is_blocked_db(user_id): show_blocked_message(update, context); return ConversationHandler.END
    
    cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
    if cell is None:
        reply_and_delete(update, context, get_text(user_id, 'code_not_found'))
        return cancel_and_show_menu(update, context)
        
    try:
        status = user_sheet.cell(cell.row, STATUS_COL).value
        if status == "Blocked":
            reason = f"Accessing blocked code {agent_code}"
            block_user_db(user_id, reason=reason)
            show_blocked_message(update, context)
            return cancel_and_show_menu(update, context)
    except Exception: pass

    password = user_sheet.cell(cell.row, PASSWORD_COL).value
    if not password or not password.strip():
        reply_and_delete(update, context, get_text(user_id, 'set_pass_prompt'))
        return cancel_and_show_menu(update, context)
    
    # Save Agent Code for checks later
    context.user_data.update({'agent_code': agent_code, 'row': cell.row, 'saved_password': password.strip("'")})
    reply_and_delete(update, context, get_text(user_id, 'enter_pass'), reply_markup=BACK_KEYBOARD)
    return next_state

