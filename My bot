        reply_and_delete(update, context, "❌ Agent Code পাওয়া যায়নি।")
        return SUBTRACT_MONEY_CODE

def subtract_money_get_amount(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    try:
        amount = float(update.message.text.strip())
        if amount > context.user_data['sub_bal']: raise ValueError
        
        row = context.user_data['sub_row']
        new_bal = context.user_data['sub_bal'] - amount
        user_sheet.update_cell(row, BALANCE_COL, new_bal)
        
        reply_and_delete(update, context, f"✅ কমানো হয়েছে: ৳{amount}\nনতুন ব্যালেন্স: ৳{new_bal}")
        
        # Notify User (Bilingual)
        uid_str = user_sheet.cell(row, USER_ID_COL).value
        if uid_str and uid_str.isdigit():
            u_id = int(uid_str)
            if not is_blocked_db(u_id):
                lang = get_user_lang(u_id)
                msg = f"🚨 Admin deducted ৳{amount}.\nNew Balance: ৳{new_bal}" if lang == 'en' else f"🚨 অ্যাডমিন ৳{amount} কমিয়েছে।\nনতুন ব্যালেন্স: ৳{new_bal}"
                context.bot.send_message(u_id, msg)
                
    except:
        reply_and_delete(update, context, "❌ ভুল ইনপুট বা অপর্যাপ্ত ব্যালেন্স।")
        return SUBTRACT_MONEY_AMOUNT
    
    context.user_data.clear()
    show_full_admin_menu(update)
    return ConversationHandler.END

