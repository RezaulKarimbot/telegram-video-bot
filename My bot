def withdraw_get_amount(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    user_id = update.effective_user.id
    
    try:
        amount = float(update.message.text.strip())
        if amount < 50: reply_and_delete(update, context, get_text(user_id, 'min_withdraw')); return ASK_AMOUNT
        if amount > context.user_data['w_bal']: reply_and_delete(update, context, "❌ Low Balance."); return ASK_AMOUNT
    except:
        reply_and_delete(update, context, "❌ Invalid Amount.")
        return ASK_AMOUNT
    
    context.user_data['w_amount'] = amount
    method = context.user_data['w_method']
    
    # 1. PERMANENT MESSAGE (Fee Calc)
    fee, receivable = (WITHDRAWAL_FEE, amount - WITHDRAWAL_FEE) if method in ['Bkash', 'Nagad'] else (0, amount)
    
    if fee > 0:
        conf_msg = get_text(user_id, 'confirm_req_msg', amount=amount, fee=fee, receivable=receivable)
    else:
        conf_msg = get_text(user_id, 'confirm_req_msg_no_fee', amount=amount)
        
    context.bot.send_message(user_id, conf_msg, parse_mode=ParseMode.MARKDOWN)

    # 2. TEMPORARY MESSAGE (Warning + Animation)
    msg = context.bot.send_message(user_id, get_text(user_id, 'processing_msg'), parse_mode=ParseMode.MARKDOWN)
    time.sleep(1)
    
    final_warn = (
        f"{get_text(user_id, 'req_sent_title')}\n\n"
        f"{get_text(user_id, 'warning_notice')}\n"
        f"👮‍♂️ **Admin ID:** `{ADMIN_IDS[0]}`"
    )
    btn_text = get_text(user_id, 'admin_contact_btn')
    kb = [[InlineKeyboardButton(btn_text, url=f"tg://user?id={ADMIN_IDS[0]}")]]
    
    try:
        # Edit the processing message to final warning
        sent_w = context.bot.edit_message_text(chat_id=msg.chat_id, message_id=msg.message_id, 
                                      text=final_warn, reply_markup=InlineKeyboardMarkup(kb), 
                                      parse_mode=ParseMode.MARKDOWN)
        context.user_data['u_msg_id'] = sent_w.message_id
    except:
        # Fallback if edit fails
        sent_w = context.bot.send_message(user_id, final_warn, reply_markup=InlineKeyboardMarkup(kb), parse_mode=ParseMode.MARKDOWN)
        context.user_data['u_msg_id'] = sent_w.message_id

    send_request_to_admin(update, context)
    context.user_data.clear()
    show_main_menu(update)
    return ConversationHandler.END

def send_request_to_admin(update, context):
    ud = context.user_data
    uid = update.effective_user.id
    amt = ud['w_amount']
    code = ud['w_code']
    msg_id = ud.get('u_msg_id')
    
    req_id = f"{uid}_{int(time.time())}"
    
    # Save to DB
    cur.execute("INSERT INTO payment_history (request_id, user_id, agent_code, status, amount, timestamp, user_message_id) VALUES (?,?,?,?,?,?,?)",
                (req_id, uid, code, "⏳ পেন্ডিং", amt, int(time.time()), msg_id))
    conn.commit()
    
    # Admin Msg
    txt = f"⚠️ **New Request**\nUser: `{uid}`\nCode: `{code}`\nAmt: `{amt}`\nMethod: `{ud['w_method']}`\nNum: `{ud['w_num']}`"
    cb_pay = f"pay:{req_id}:{code}:{amt}:{uid}"
    cb_cancel = f"cancel:{req_id}:{code}:{amt}:{uid}"
    kb = [[InlineKeyboardButton("✅ Pay", callback_data=cb_pay), InlineKeyboardButton("❌ Cancel", callback_data=cb_cancel)]]
    
    refs = []
    for admin in ADMIN_IDS:
        try:
            m = context.bot.send_message(admin, txt, reply_markup=InlineKeyboardMarkup(kb), parse_mode=ParseMode.MARKDOWN)
            refs.append((admin, m.message_id))
        except: pass
        
    context.bot_data.setdefault('w_reqs', {})[req_id] = refs

def handle_payment_action(update: Update, context: CallbackContext):
    query = update.callback_query; query.answer()
    try: action, req_id, code, amt_s, uid_s = query.data.split(':')
    except: return
    
    uid = int(uid_s)
    amt = float(amt_s)
    
    if action == 'cancel':
        # Auto delete user warning message
        try:
            cur.execute("SELECT user_message_id FROM payment_history WHERE request_id=?", (req_id,))
            res = cur.fetchone()
            if res and res[0]: context.bot.delete_message(uid, res[0])
        except: pass
        
        cur.execute("UPDATE payment_history SET status=? WHERE request_id=?", ("❌ Cancelled", req_id))
        conn.commit()
        if not is_blocked_db(uid): context.bot.send_message(uid, f"❌ Request for ৳{amt} cancelled.")
        query.edit_message_text(f"❌ Cancelled by Admin.")
        
    elif action == 'pay':
        cell = find_cell_robust(code, in_column=AGENT_CODE_COL)
        if cell:
            curr = float((user_sheet.cell(cell.row, BALANCE_COL).value or "0").replace(',',''))
            if curr < amt:
                query.edit_message_text("⚠️ Low Balance in Sheet!")
                return
                
            user_sheet.update_cell(cell.row, BALANCE_COL, curr - amt)
            
            # Auto delete user warning message
            try:
                cur.execute("SELECT user_message_id FROM payment_history WHERE request_id=?", (req_id,))
                res = cur.fetchone()
                if res and res[0]: context.bot.delete_message(uid, res[0])
            except: pass
            
            # Update DB timestamp for 24h limit
            cur.execute("UPDATE payment_history SET status=?, timestamp=? WHERE request_id=?", ("✅ Approved", int(time.time()), req_id))
            conn.commit()
            
            if not is_blocked_db(uid): context.bot.send_message(uid, f"✅ Payment of ৳{amt} Approved!")
            query.edit_message_text(f"✅ Paid ৳{amt} to {code}.")

# --- MAIN ---
def main():
    updater = Updater(BOT_TOKEN, use_context=True, workers=32)
    dp = updater.dispatcher
    
    # Filters
    back_filter = Filters.regex(f'^{BACK_BUTTON_TEXT}$') | Filters.regex('^⬅️ ফিরে যান$') | Filters.regex('^⬅️ Back$')
    
    # Handlers
    dp.add_handler(CommandHandler("start", start))
    dp.add_handler(CallbackQueryHandler(lang_selection_callback, pattern='^setlang_'))
    
    # User Menu Handlers (Regex matched against TRANS dict values)
    # Note: Regex needs to match both BN and EN for robustness
    dp.add_handler(MessageHandler(Filters.regex('^(🔑 কোড পান|🔑 Get Code)$'), get_code_start))
    dp.add_handler(MessageHandler(Filters.regex('^(💰 আমার একাউন্ট|💰 My Account)$'), balance_check_start))
    dp.add_handler(MessageHandler(Filters.regex('^(📋 Agent Code দিয়ে ডিটেল চেক|📋 Check Details.*)$'), get_details_start))
    dp.add_handler(MessageHandler(Filters.regex('^(💸 টাকা তুলুন.*|💸 Withdraw Money)$'), withdraw_start))
    dp.add_handler(MessageHandler(Filters.regex('^(\(পাসওয়ার্ড & পেমেন্ট.*\)|.*Change Pass.*)$'), update_info_start))
    dp.add_handler(MessageHandler(Filters.regex('^(ℹ️ হেল্প|ℹ️ Help)$'), help_button_handler))
    
    # Admin Handlers
    dp.add_handler(MessageHandler(Filters.regex('^➕ টাকা এড করুন$'), add_money_start))
    dp.add_handler(MessageHandler(Filters.regex('^➕ বাল্ক টাকা এড$'), bulk_add_start))
