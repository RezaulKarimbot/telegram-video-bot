def get_last_approved_time(agent_code: str) -> int:
    try:
        cur.execute("SELECT MAX(timestamp) FROM payment_history WHERE agent_code = ? AND status = '✅ অ্যাপ্রুভড'", (agent_code,))
        result = cur.fetchone()
        return result[0] if result and result[0] else 0
