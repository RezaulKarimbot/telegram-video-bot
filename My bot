    if not is_admin(update.message.from_user.id): return ConversationHandler.END
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    
    if context.user_data.get('bulk_metadata'):
        d, s, r = context.user_data['bulk_metadata']
        msg = f"💾 **Saved Data:**\nDate: `{d}`\nSource: `{s}`\nRate: `{r}`\n\nSend list: `Amount AgentCode`"
        reply_and_delete(update, context, msg, parse_mode=ParseMode.MARKDOWN)
        return BULK_PROCESS_LIST
    else:
        reply_and_delete(update, context, "Set Defaults: `Date / Source / Rate`", reply_markup=BACK_KEYBOARD)
        return BULK_SETUP_DEFAULTS

def handle_bulk_defaults(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    try:
        d, s, r = [x.strip() for x in update.message.text.split('/')]
        context.user_data['bulk_metadata'] = (d, s, r)
        reply_and_delete(update, context, f"✅ Saved!\nNow send list: `Amount AgentCode`")
        return BULK_PROCESS_LIST
    except:
        reply_and_delete(update, context, "❌ Format: `Date / Source / Rate`")
        return BULK_SETUP_DEFAULTS

def handle_bulk_process(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    text = update.message.text.strip()
    
    if text == "♻️ সেভ মেসেজ কিলিয়ার":
        context.user_data.pop('bulk_metadata', None)
        return bulk_add_start(update, context)

    if not context.user_data.get('bulk_metadata'): return bulk_add_start(update, context)
    
    date, source, rate = context.user_data['bulk_metadata']
    lines = text.split('\n')
    report = "📋 Report:\n"
    
    for line in lines:
        if not line.strip(): continue
        try:
            parts = line.split()
            amount = float(parts[0])
            code = parts[-1]
            
            cell = find_cell_robust(code, in_column=AGENT_CODE_COL)
            if cell:
                curr = float((user_sheet.cell(cell.row, BALANCE_COL).value or "0").replace(',',''))
                new_b = curr + amount
                user_sheet.update_cell(cell.row, BALANCE_COL, new_b)
                
                cur.execute("INSERT INTO add_money_history (agent_code, amount, source, date_text, rate_text, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
                            (code, amount, source, date, rate, int(time.time())))
                conn.commit()
                report += f"✅ {code}: +{amount}\n"
                
                # Notify User (Bilingual)
                uid_str = user_sheet.cell(cell.row, USER_ID_COL).value
                if uid_str and uid_str.isdigit():
                    u_id = int(uid_str)
                    if not is_blocked_db(u_id):
                        lang = get_user_lang(u_id)
                        header = "🎉 **Money Added**" if lang == 'en' else "🎉 **টাকা যোগ হয়েছে**"
                        context.bot.send_message(u_id, f"{header}\nAmount: ৳{amount}\nBal: ৳{new_b}", parse_mode=ParseMode.MARKDOWN)
            else:
                report += f"❌ {code}: Not Found\n"
        except:
            report += f"❌ Error: {line}\n"
            
    if len(report) > 4000: update.message.reply_text(report[:4000])
    else: update.message.reply_text(report)
    return BULK_PROCESS_LIST

