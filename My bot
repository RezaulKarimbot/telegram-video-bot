# --- Language Helper Functions ---
def get_user_lang(user_id: int) -> str:
    try:
        cur.execute("SELECT language FROM verified_users WHERE user_id = ?", (user_id,))
        res = cur.fetchone()
        return res[0] if res else 'bn'
    except Exception:
        return 'bn'

def set_user_lang(user_id: int, lang: str):
    try:
        cur.execute("INSERT OR IGNORE INTO verified_users (user_id, language) VALUES (?, ?)", (user_id, lang))
        cur.execute("UPDATE verified_users SET language = ? WHERE user_id = ?", (lang, user_id))
        conn.commit()
    except Exception as e:
        logger.error(f"Error setting lang: {e}")

def get_text(user_id: int, key: str, **kwargs) -> str:
    lang = get_user_lang(user_id)
    text_template = TRANS.get(key, {}).get(lang, TRANS[key]['bn']) # Fallback to Bangla
    try:
        return text_template.format(**kwargs)
    except Exception:
        return text_template
# --- Standard Utils ---
def delete_message_callback(context: CallbackContext):
    try:
        context.bot.delete_message(chat_id=context.job.context['chat_id'], message_id=context.job.context['message_id'])
    except Exception as e:
        logger.warning(f"Could not auto-delete message: {e}")

def schedule_message_deletion(context: CallbackContext, message, user_id):
    delay = ADMIN_DELETE_DELAY if is_admin(user_id) else USER_DELETE_DELAY
    context.job_queue.run_once(
        delete_message_callback,
        delay,
        context={'chat_id': message.chat_id, 'message_id': message.message_id}
    )

def reply_and_delete(update_or_query, context: CallbackContext, text: str, **kwargs):
    chat = None; user_id = None
    if hasattr(update_or_query, 'message') and update_or_query.message:
        chat = update_or_query.message.chat; user_id = update_or_query.message.from_user.id
        sent_message = chat.send_message(text, **kwargs)
    elif hasattr(update_or_query, 'effective_chat') and update_or_query.effective_chat:
        chat = update_or_query.effective_chat; user_id = update_or_query.effective_user.id
        sent_message = chat.send_message(text, **kwargs)
    else: return None

    if not is_admin(user_id):
        schedule_message_deletion(context, sent_message, user_id)
    return sent_message

# --- Database & Helper Functions ---
def is_verified_db(user_id: int) -> bool:
    cur.execute("SELECT 1 FROM verified_users WHERE user_id = ?", (user_id,))
    return cur.fetchone() is not None

def set_verified_db(user_id: int):
    try: 
        cur.execute("INSERT OR IGNORE INTO verified_users (user_id) VALUES (?)", (user_id,))
        conn.commit()
    except Exception as e: logger.error(f"SQLite insert error: {e}")

def is_blocked_db(user_id: int) -> bool:
    cur.execute("SELECT 1 FROM blocked_users WHERE user_id = ?", (user_id,))
    return cur.fetchone() is not None

def get_blocked_reason(user_id: int) -> str:
    cur.execute("SELECT reason FROM blocked_users WHERE user_id = ?", (user_id,))
    row = cur.fetchone()
    return row[0] if row else "N/A"

def block_user_db(user_id: int, reason: str):
    try:
        cur.execute("INSERT OR REPLACE INTO blocked_users (user_id, reason, timestamp) VALUES (?, ?, ?)", 
                    (user_id, reason, int(time.time())))
        conn.commit()
        logger.info(f"Blocked user {user_id} in DB for reason: {reason}")
    except Exception as e:
        logger.error(f"SQLite block user error: {e}")

def unblock_user_db(user_id: int):
    try:
        cur.execute("DELETE FROM blocked_users WHERE user_id = ?", (user_id,))
        conn.commit()
        logger.info(f"Unblocked user {user_id} in DB")
    except Exception as e:
        logger.error(f"SQLite unblock user error: {e}")

def get_fail_count(agent_code: str) -> int:
    cur.execute("SELECT count FROM reset_fails WHERE agent_code = ?", (agent_code,))
    row = cur.fetchone()
    return row[0] if row else 0

def increment_fail_count(agent_code: str):
    count = get_fail_count(agent_code) + 1
    cur.execute("INSERT OR REPLACE INTO reset_fails (agent_code, count) VALUES (?, ?)", (agent_code, count))
    conn.commit()
    return count

def clear_fail_count(agent_code: str):
    cur.execute("DELETE FROM reset_fails WHERE agent_code = ?", (agent_code,))
    conn.commit()

# --- Helper for Payment Methods ---
def is_method_active(method_name: str) -> bool:
    cur.execute("SELECT is_active FROM payment_methods WHERE method_name = ?", (method_name,))
    row = cur.fetchone()
    return row[0] == 1 if row else False

def toggle_method_status(method_name: str):
    current_status = is_method_active(method_name)
    new_status = 0 if current_status else 1
    cur.execute("UPDATE payment_methods SET is_active = ? WHERE method_name = ?", (new_status, method_name))
    conn.commit()
    return new_status

def generate_unique_code(existing_codes, min_len=4, max_len=12):
    for _ in range(2000):
        length = random.randint(min_len, max_len)
        code = "".join(random.choices("0123456789", k=length))
        if code not in existing_codes: return code
    return None

def has_pending_request(user_id: int) -> bool:
    cur.execute("SELECT 1 FROM payment_history WHERE user_id = ? AND status = '⏳ পেন্ডিং'", (user_id,))
    return cur.fetchone() is not None

def is_code_pending(agent_code: str) -> bool:
    cur.execute("SELECT 1 FROM payment_history WHERE agent_code = ? AND status = '⏳ পেন্ডিং'", (agent_code,))
