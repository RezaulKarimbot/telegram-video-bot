def handle_bulk_process(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    text = update.message.text.strip()
    
    if text == "♻️ সেভ মেসেজ কিলিয়ার":
        context.user_data.pop('bulk_metadata', None)
        reply_and_delete(update, context, "🗑️ সেভ করা তথ্য মুছে ফেলা হয়েছে। আবার নতুন করে তথ্য দিন।")
        return bulk_add_start(update, context)

    saved_metadata = context.user_data.get('bulk_metadata')
    if not saved_metadata:
        reply_and_delete(update, context, "⚠️ সেভ করা তথ্য পাওয়া যায়নি। দয়া করে আবার শুরু করুন।")
        return bulk_add_start(update, context)
        
    date, source, rate = saved_metadata
    lines = text.split('\n')
    
    success_count = 0
    fail_count = 0
    report = "📋 **বাল্ক প্রসেসিং রিপোর্ট:**\n\n"
    reply_and_delete(update, context, "⏳ প্রসেসিং হচ্ছে... অনুগ্রহ করে অপেক্ষা করুন...")

    for line in lines:
        if not line.strip(): continue
        
        try:
            parts = line.split()
            if len(parts) < 2:
                report += f"❌ Format Error: `{line}`\n"
                fail_count += 1
                continue
            
            amount_str = parts[0].strip()   
            agent_code = parts[-1].strip()  
            
            try:
                amount_to_add = float(amount_str)
            except ValueError:
                report += f"❌ Amount Error ({agent_code}): `{amount_str}`\n"
                fail_count += 1
                continue

            cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
            if not cell:
                report += f"❌ Code Not Found: `{agent_code}`\n"
                fail_count += 1
                continue
            
            row_index = cell.row
            current_balance = float((user_sheet.cell(row_index, BALANCE_COL).value or "0").replace(',', ''))
            new_balance = current_balance + amount_to_add
            user_sheet.update_cell(row_index, BALANCE_COL, new_balance)
            
            cur.execute("INSERT INTO add_money_history (agent_code, amount, source, date_text, rate_text, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
                        (agent_code, amount_to_add, source, date, rate, int(time.time())))
            conn.commit()
            
            success_count += 1
            report += f"✅ Added ৳{amount_to_add} to `{agent_code}`\n"
            
            target_user_id_str = user_sheet.cell(row_index, USER_ID_COL).value
            if target_user_id_str and target_user_id_str.isdigit():
                if not is_blocked_db(int(target_user_id_str)):
                    notification_text = (
                        f"🎉 **টাকা যোগ হয়েছে** 🎉\n\n"
                        f"💰 **পরিমাণ:** ৳{amount_to_add}\n"
                        f"📝 **কিসের টাকা:** {source}\n"
                        f"📅 **তারিখ:** {date}\n"
                        f"💵 **রেট:** {rate}\n\n"
                        f"🏦 **বর্তমান ব্যালেন্স:** ৳{new_balance}"
                    )
                    user_markup = InlineKeyboardMarkup([
                        [InlineKeyboardButton("বট থেকে টাকা তুলার নিয়ম", url="https://t.me/social_workars4/658")]
                    ])
                    try:
                        sent_msg = context.bot.send_message(chat_id=int(target_user_id_str), text=notification_text, reply_markup=user_markup, parse_mode=ParseMode.MARKDOWN)
                        context.job_queue.run_once(
                            delete_message_callback,
                            86400, 
                            context={'chat_id': sent_msg.chat_id, 'message_id': sent_msg.message_id}
                        )
                    except Exception as e:
                        logger.error(f"Failed to notify user {target_user_id_str}: {e}")

        except Exception as e:
            logger.error(f"Bulk add error for line {line}: {e}")
            report += f"❌ System Error: `{line}`\n"
            fail_count += 1
            
    final_summary = f"\n✅ সফল: {success_count}\n❌ ব্যর্থ: {fail_count}\n\n`{date} = {source}`"
    
    if len(report) > 4000:
        chunks = [report[i:i+4000] for i in range(0, len(report), 4000)]
        for chunk in chunks:
            update.message.reply_text(chunk, parse_mode=ParseMode.MARKDOWN)
        update.message.reply_text(final_summary, parse_mode=ParseMode.MARKDOWN)
    else:
        update.message.reply_text(report + final_summary, parse_mode=ParseMode.MARKDOWN)
    
    keyboard = ReplyKeyboardMarkup([[KeyboardButton("♻️ সেভ মেসেজ কিলিয়ার")], [KeyboardButton(BACK_BUTTON_TEXT)]], resize_keyboard=True, one_time_keyboard=True)
    update.message.reply_text("আরও এড করতে চাইলে লিস্ট দিন, অথবা '♻️ সেভ মেসেজ কিলিয়ার' চাপুন।", reply_markup=keyboard)
    return BULK_PROCESS_LIST
