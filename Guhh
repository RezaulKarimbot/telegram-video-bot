def fix_payment_get_code(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    agent_code = update.message.text.strip()
    
    # 1. Find User ID from Sheet
    cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
    if not cell:
        reply_and_delete(update, context, "❌ এই Agent Code টি পাওয়া যায়নি।")
        return FIX_PAYMENT_CODE
        
    user_id_str = user_sheet.cell(cell.row, USER_ID_COL).value
    if not user_id_str or not user_id_str.isdigit():
        reply_and_delete(update, context, "❌ এই কোডের সাথে কোনো Telegram ID পাওয়া যায়নি।")
        return cancel_and_show_menu(update, context)
        
    user_id = int(user_id_str)
    
    # 2. Update DB status from Pending to Approved (or any non-pending state)
    try:
        cur.execute("SELECT COUNT(*) FROM payment_history WHERE user_id = ? AND status = '⏳ পেন্ডিং'", (user_id,))
        count = cur.fetchone()[0]
        
        if count == 0:
            reply_and_delete(update, context, "ℹ️ এই ইউজারের কোনো পেন্ডিং পেমেন্ট পাওয়া যায়নি।")
        else:
            cur.execute("UPDATE payment_history SET status = '✅ ম্যানুয়াল ফিক্স' WHERE user_id = ? AND status = '⏳ পেন্ডিং'", (user_id,))
            conn.commit()
            reply_and_delete(update, context, f"✅ সফল! {count} টি আটকে থাকা পেমেন্ট ক্লিয়ার করা হয়েছে।\nইউজার এখন নতুন রিকোয়েস্ট দিতে পারবে।")
            
            # Optional: Notify user
            try:
                context.bot.send_message(chat_id=user_id, text="✅ আপনার আটকে থাকা পেমেন্ট স্ট্যাটাস ঠিক করা হয়েছে। আপনি এখন আবার চেষ্টা করতে পারেন।")
            except Exception:
                pass
                
    except Exception as e:
        logger.error(f"Fix payment error: {e}")
        reply_and_delete(update, context, "❌ ডাটাবেস আপডেট করতে সমস্যা হয়েছে।")
        
    return cancel_and_show_menu(update, context)

