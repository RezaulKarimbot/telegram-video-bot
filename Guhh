def send_withdrawal_request_to_admins(update: Update, context: CallbackContext):
    user_data = context.user_data; details = user_data['user_details']; user_telegram_id = update.effective_user.id
    amount_requested = user_data['withdraw_amount']; method = user_data['withdraw_method']
    agent_code = user_data['withdraw_code']
    user_message_id = user_data.get('user_message_id') # Get the warning message ID
    
    fee, amount_to_receive = (WITHDRAWAL_FEE, amount_requested - WITHDRAWAL_FEE) if method in ['Bkash', 'Nagad'] else (0, amount_requested)
    
    epoch_time = int(time.time())
    request_id = f"{user_telegram_id}_{epoch_time}"
    
    def safe_get(index, r_data): return r_data[index].strip("'") if index < len(r_data) and str(r_data[index]).strip() else "N/A"
    text = (f"⚠️ **নতুন পেমেন্ট রিকোয়েস্ট** ⚠️\n\n👤 **নাম:** `{safe_get(NAME_COL - 1, details)}`\n🔑 **Agent Code:** `{agent_code}`\n\n💸 **Amount Requested:** `৳{amount_requested}`\n📉 **Fee:** `৳{fee}`\n💵 **User Will Receive:** `৳{amount_to_receive}`\n\n💳 **Method:** `{method}`\n#️⃣ **Number/ID:** `{user_data['withdraw_number'].strip()}`")
    
    callback_data_approve = f"pay:{request_id}:{agent_code}:{amount_requested}:{user_telegram_id}"
    callback_data_cancel = f"cancel:{request_id}:{agent_code}:{amount_requested}:{user_telegram_id}"
    keyboard = [[InlineKeyboardButton("✅ Payment Done", callback_data=callback_data_approve), InlineKeyboardButton("❌ Cancel", callback_data=callback_data_cancel)]]
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    message_references = []
    if PRIVATE_CHANNEL_ID and PRIVATE_CHANNEL_ID != 0:
        try: 
            msg = context.bot.send_message(chat_id=PRIVATE_CHANNEL_ID, text=text, reply_markup=reply_markup, parse_mode=ParseMode.MARKDOWN)
            message_references.append((msg.chat_id, msg.message_id))
        except Exception as e: logger.error(f"Failed to send request to private channel {PRIVATE_CHANNEL_ID}: {e}")
    for admin_id in ADMIN_IDS:
        try: 
            msg = context.bot.send_message(chat_id=admin_id, text=text, reply_markup=reply_markup, parse_mode=ParseMode.MARKDOWN)
            message_references.append((msg.chat_id, msg.message_id))
        except Exception as e: logger.error(f"Failed to send request to admin {admin_id}: {e}")
            
    if 'withdrawal_requests' not in context.bot_data:
        context.bot_data['withdrawal_requests'] = {}
    context.bot_data['withdrawal_requests'][request_id] = message_references

    try:
        # Insert Agent Code and User Message ID into DB
        cur.execute("INSERT INTO payment_history (request_id, user_id, agent_code, status, amount, timestamp, user_message_id) VALUES (?, ?, ?, ?, ?, ?, ?)", 
                    (request_id, user_telegram_id, agent_code, "⏳ পেন্ডিং", amount_requested, epoch_time, user_message_id))
        conn.commit()
    except Exception as e:
        logger.error(f"Failed to write pending request to DB: {e}")


def handle_payment_action(update: Update, context: CallbackContext):
    query = update.callback_query; admin_user = query.from_user; query.answer()
    
    try: action, request_id, agent_code, amount_str, user_id_str = query.data.split(':')
    except ValueError: logger.error(f"Could not unpack callback_data: {query.data}"); return
            
    if action == 'cancel':
        context.user_data.update({'request_id': request_id, 'agent_code': agent_code, 'amount': float(amount_str), 'user_id': int(user_id_str), 'original_message_text': query.message.text_markdown})
        keyboard = [[InlineKeyboardButton("✍️ কারণ লিখুন", callback_data="cancel_with_reason")], [InlineKeyboardButton("⏩ কারণ নেই", callback_data="cancel_no_reason")]]
        reply_markup = InlineKeyboardMarkup(keyboard)
        sent_message = query.edit_message_text("আপনি কি বাতিলের কারণ উল্লেখ করতে চান?", reply_markup=reply_markup)
        context.user_data['last_bot_message'] = sent_message
        return CHOOSE_CANCEL_OPTION

    amount = float(amount_str); user_id = int(user_id_str)
    final_text = ""
    cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
    if not cell:
        final_text = query.message.text_markdown + f"\n\n❌ **ত্রুটি:** Agent Code `{agent_code}` পাওয়া যায়নি।"
    else:
        try:
            row_index = cell.row
            if action == 'pay':
                current_balance = float((user_sheet.cell(row_index, BALANCE_COL).value or "0").replace(',', ''))
                if current_balance < amount:
                     final_text = query.message.text_markdown + f"\n\n⚠️ **ব্যালেন্স কম!** (처리자: {admin_user.first_name})"
                     if not is_blocked_db(user_id):
                        context.bot.send_message(user_id, "❌ আপনার পেমেন্ট বাতিল হয়েছে কারণ একাউন্টে পর্যাপ্ত ব্যালেন্স নেই।")
                     cur.execute("UPDATE payment_history SET status = ? WHERE request_id = ?", ("❌ বাতিল (ব্যালেন্স কম)", request_id))
                else:
                    new_balance = current_balance - amount; user_sheet.update_cell(row_index, BALANCE_COL, new_balance)
                    final_text = query.message.text_markdown + f"\n\n✅ **পেমেন্ট সফল!** (처리자: {admin_user.first_name})"
                    
                    # --- AUTO DELETE USER MESSAGE START ---
                    try:
                        cur.execute("SELECT user_message_id FROM payment_history WHERE request_id = ?", (request_id,))
                        result = cur.fetchone()
                        if result and result[0]:
                            context.bot.delete_message(chat_id=user_id, message_id=result[0])
                    except Exception as e:
                        logger.warning(f"Could not auto-delete user message on approve: {e}")
                    # --- AUTO DELETE USER MESSAGE END ---

                    if not is_blocked_db(user_id):
                        context.bot.send_message(user_id, f"✅ আপনার ৳{amount} এর পেমেন্ট সফল হয়েছে। নতুন ব্যালেন্স ৳{new_balance}।")
                    
                    # Update status AND timestamp to CURRENT time so 24hr count starts NOW
                    current_ts = int(time.time())
                    cur.execute("UPDATE payment_history SET status = ?, timestamp = ? WHERE request_id = ?", ("✅ অ্যাপ্রুভড", current_ts, request_id))
            conn.commit()
        except Exception as e: 
            logger.error(f"Error in handle_payment_action (pay): {e}")
            final_text = query.message.text_markdown + "\n\n❌ **একটি মারাত্মক ত্রুটি ঘটেছে।**"
    
    message_references = context.bot_data.get('withdrawal_requests', {}).pop(request_id, [])
    for chat_id, message_id in message_references:
        try:
            context.bot.edit_message_text(chat_id=chat_id, message_id=message_id, text=final_text, parse_mode=ParseMode.MARKDOWN)
        except Exception as e:
            logger.error(f"Failed to edit message {message_id} in chat {chat_id}: {e}")

def finalize_cancellation(context: CallbackContext, admin_user, reason: str = None):
    request_id = context.user_data.get('request_id'); amount = context.user_data.get('amount')
    user_id = context.user_data.get('user_id'); original_message_text = context.user_data.get('original_message_text', '')
    
    # --- AUTO DELETE USER MESSAGE START ---
    try:
        cur.execute("SELECT user_message_id FROM payment_history WHERE request_id = ?", (request_id,))
        result = cur.fetchone()
        if result and result[0]:
            context.bot.delete_message(chat_id=user_id, message_id=result[0])
    except Exception as e:
        logger.warning(f"Could not auto-delete user message on cancel: {e}")
    # --- AUTO DELETE USER MESSAGE END ---

    user_message = f"দুঃখিত, আপনার ৳{amount} এর পেমেন্ট রিকোয়েস্ট বাতিল করা হয়েছে।"
    if reason: user_message += f"\n\nকারণ: {reason}"
    
    if user_id and not is_blocked_db(user_id):
        context.bot.send_message(user_id, user_message)
    
    status_text = f"❌ বাতিল ({reason})" if reason else "❌ বাতিল করা হয়েছে"
    try:
        cur.execute("UPDATE payment_history SET status = ? WHERE request_id = ?", (status_text, request_id))
        conn.commit()
    except Exception as e:
        logger.error(f"Failed to update cancelled status in DB: {e}")

    final_text_for_admin = original_message_text + f"\n\n❌ **পেমেন্ট বাতিল হয়েছে।** (처리자: {admin_user.first_name})"
    if reason: final_text_for_admin += f"\nকারণ: {reason}"
    message_references = context.bot_data.get('withdrawal_requests', {}).pop(request_id, [])
    for chat_id, message_id in message_references:
        try:
            context.bot.edit_message_text(chat_id=chat_id, message_id=message_id, text=final_text_for_admin, parse_mode=ParseMode.MARKDOWN)
        except Exception as e:
            logger.error(f"Failed to edit message {message_id} in chat {chat_id}: {e}")

