def has_pending_request(user_id: int) -> bool:
    cur.execute("SELECT 1 FROM payment_history WHERE user_id = ? AND status = '⏳ পেন্ডিং'", (user_id,))
    return cur.fetchone() is not None

def is_code_pending(agent_code: str) -> bool:
    """Checks if a specific agent code has a pending request from ANY user."""
    cur.execute("SELECT 1 FROM payment_history WHERE agent_code = ? AND status = '⏳ পেন্ডিং'", (agent_code,))
    return cur.fetchone() is not None

def get_last_approved_time(agent_code: str) -> int:
    """Returns the timestamp of the last approved payment for the AGENT CODE."""
    try:
        cur.execute("SELECT MAX(timestamp) FROM payment_history WHERE agent_code = ? AND status = '✅ অ্যাপ্রুভড'", (agent_code,))
        result = cur.fetchone()
        return result[0] if result and result[0] else 0
    except Exception as e:
        logger.error(f"Error fetching last approved time: {e}")
        return 0

