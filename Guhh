def verify_password_for_withdraw(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    
    user_id = update.effective_user.id
    if is_blocked_db(user_id):
        show_blocked_message(update, context)
        return ConversationHandler.END

    # Get agent code from context (Saved in get_password_and_proceed)
    agent_code = context.user_data.get('agent_code')

    # --- PENDING & 24 HOUR CHECK START (AGENT CODE BASED) ---
    if agent_code:
        # Check 1: Is there ANY pending request for this agent code (from any user)?
        if is_code_pending(agent_code):
            reply_and_delete(update, context, f"❌ Agent Code `{agent_code}` এর একটি পেমেন্ট রিকোয়েস্ট ইতোমধ্যে পেন্ডিং আছে। অনুগ্রহ করে সেটির স্ট্যাটাস আপডেট হওয়ার জন্য অপেক্ষা করুন।", parse_mode=ParseMode.MARKDOWN)
            return cancel_and_show_menu(update, context)

        # Check 2: 24 Hour Limit Check
        last_approved_time = get_last_approved_time(agent_code)
        current_time = int(time.time())
        
        # 24 hours = 86400 seconds
        if current_time - last_approved_time < 86400:
            remaining_time = 86400 - (current_time - last_approved_time)
            hours = remaining_time // 3600
            minutes = (remaining_time % 3600) // 60
            
            warning_msg = (
                "⚠️ **লিমিট অতিক্রম!** ⚠️\n\n"
                f"এই Agent Code (`{agent_code}`) দিয়ে ২৪ ঘন্টার মধ্যে একবার পেমেন্ট নেওয়া হয়েছে।\n"
                "অন্য কোনো আইডি দিয়েও এই কোড ব্যবহার করে এখন রিকোয়েস্ট করা যাবে না।\n\n"
                f"⏳ **আবার রিকোয়েস্ট করতে পারবেন:** {hours} ঘন্টা {minutes} মিনিট পর।"
            )
            reply_and_delete(update, context, warning_msg, parse_mode=ParseMode.MARKDOWN)
            return cancel_and_show_menu(update, context)
    # --- PENDING & 24 HOUR CHECK END ---

    password = update.message.text.strip()
    if password != context.user_data['saved_password']:
        reply_and_delete(update, context, "❌ ভুল পাসওয়ার্ড।"); return cancel_and_show_menu(update, context)
    
    row = context.user_data['row']
    user_sheet.update_cell(row, USER_ID_COL, update.effective_user.id)
    
    user_details = user_sheet.row_values(row)
    balance = float((user_details[BALANCE_COL - 1] if len(user_details) >= BALANCE_COL else "0").replace(',', ''))
    if balance < 50:
        reply_and_delete(update, context, f"❌ আপনার একাউন্টে পর্যাপ্ত ব্যালেন্স নেই। ন্যূনতম ৳৫০ প্রয়োজন।")
        return cancel_and_show_menu(update, context)
    
    context.user_data.update({
        'withdraw_code': agent_code, 
        'withdraw_balance': balance, 
        'user_details': user_details
    })
    
    keyboard = [
        [InlineKeyboardButton("💳 বিকাশ", callback_data="withdraw_bkash")],
        [InlineKeyboardButton("💳 নগদ", callback_data="withdraw_nagad")],
        [InlineKeyboardButton("🚀 রকেট", callback_data="withdraw_rocket")],
        [InlineKeyboardButton("🏦 Binance", callback_data="withdraw_binance")]
