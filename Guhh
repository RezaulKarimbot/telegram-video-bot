def find_cell_robust(query, in_column, sheet_obj=user_sheet):
    try:
        values = sheet_obj.col_values(in_column, value_render_option='FORMATTED_VALUE')
        cleaned_values = [val.strip("'") for val in values]
        if query in cleaned_values:
            row = cleaned_values.index(query) + 1
            return gspread.Cell(row, in_column, value=query)
        else:
            return None
    except Exception as e:
        logger.error(f"Error in find_cell_robust: {e}")
        return None

