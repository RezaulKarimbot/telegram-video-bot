def show_method_control_panel(update_or_query, context: CallbackContext):
    keyboard = []
    for method in ['Bkash', 'Nagad', 'Rocket', 'Binance']:
        status = is_method_active(method)
        icon = "✅" if status else "❌"
        text = f"{icon} {method}"
        keyboard.append([InlineKeyboardButton(text, callback_data=f"toggle_{method}")])
    
    keyboard.append([InlineKeyboardButton("🔙 ফিরে যান", callback_data="admin_back")])
    reply_markup = InlineKeyboardMarkup(keyboard)
    
    text = "⚙️ **পেমেন্ট মেথড কন্ট্রোল প্যানেল**\n\nযেই মেথডটি চালু বা বন্ধ করতে চান সেটিতে ক্লিক করুন:"
    
    if hasattr(update_or_query, 'message') and update_or_query.message:
         update_or_query.message.reply_text(text, reply_markup=reply_markup, parse_mode=ParseMode.MARKDOWN)
    elif hasattr(update_or_query, 'callback_query') and update_or_query.callback_query:
         update_or_query.callback_query.edit_message_text(text, reply_markup=reply_markup, parse_mode=ParseMode.MARKDOWN)

def handle_method_toggle(update: Update, context: CallbackContext):
    query = update.callback_query
    query.answer()
    
    if query.data == "admin_back":
        query.delete_message()
        return ConversationHandler.END
        
    method_name = query.data.split('_')[1]
    new_status = toggle_method_status(method_name)
    
    status_text = "চালু" if new_status else "বন্ধ"
    query.answer(f"{method_name} এখন {status_text} করা হয়েছে।")
    
    show_method_control_panel(update, context)
    return METHOD_CONTROL

