    return RESET_CODE

def reset_password_get_code(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    agent_code = update.message.text.strip()
    user_id = update.message.from_user.id
    
    if get_fail_count(agent_code) >= 3:
        reason = f"3 times wrong details for code {agent_code}"
        cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
        if cell:
             user_sheet.update_cell(cell.row, STATUS_COL, "Blocked")
             
        block_user_db(user_id, reason)
        show_blocked_message(update, context)
        return ConversationHandler.END

    cell = find_cell_robust(agent_code, in_column=AGENT_CODE_COL)
    if not cell:
        reply_and_delete(update, context, "❌ এই Agent Code টি পাওয়া যায়নি। আবার চেষ্টা করুন।")
        return RESET_CODE
    
    try:
        status = user_sheet.cell(cell.row, STATUS_COL).value
        if status == "Blocked":
            block_user_db(user_id, f"Attempted access to blocked code {agent_code}")
            show_blocked_message(update, context)
            return ConversationHandler.END
    except Exception: pass

    row_values = user_sheet.row_values(cell.row)
    saved_user_id_raw = row_values[USER_ID_COL-1] if len(row_values) >= USER_ID_COL else ""
    saved_user_id = str(saved_user_id_raw).strip("'").strip()
    current_user_id = str(user_id)
    
    if saved_user_id and saved_user_id != current_user_id:
        reply_and_delete(update, context, "❌ দুঃখিত! শুধুমাত্র যেই একাউন্ট দিয়ে এজেন্ট কোড এবং পাসওয়ার্ড নিয়েছেন সেই একাউন্ট দিয়ে রিসেট করতে পারবেন।")
        return cancel_and_show_menu(update, context)

    field_map = {
        2: "Email address",
        3: "Name",
        4: "WhatsApp Number",
        5: "Telegram Number/ID",
        6: "Bkash Number",
        7: "Nagad Number",
    }
    
    valid_indices = []
    for idx, col_name in field_map.items():
        val = row_values[idx-1] if len(row_values) >= idx else ""
        if val and str(val).strip():
            valid_indices.append(idx)
            
    if not valid_indices:
        reply_and_delete(update, context, "❌ আপনার একাউন্টে পর্যাপ্ত তথ্য নেই ভেরিফিকেশনের জন্য। এডমিনের সাথে যোগাযোগ করুন।")
        return cancel_and_show_menu(update, context)
        
    selected_idx = random.choice(valid_indices)
    field_name = field_map[selected_idx]
    expected_value = row_values[selected_idx-1].strip("'").strip()
    
    context.user_data['reset_row'] = cell.row
    context.user_data['reset_agent_code'] = agent_code
    context.user_data['reset_expected'] = expected_value
    context.user_data['reset_field'] = field_name
    
    reply_and_delete(update, context, f"🔒 ভেরিফিকেশন: আপনার রেজিস্ট্রেশন করার সময় দেওয়া **{field_name}** টি দিন:", parse_mode=ParseMode.MARKDOWN)
    return RESET_VERIFY

