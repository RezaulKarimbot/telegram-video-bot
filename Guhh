def view_add_history_get_code(update: Update, context: CallbackContext):
    schedule_message_deletion(context, update.message, update.message.from_user.id)
    agent_code = update.message.text.strip()
    
    try:
        cur.execute("SELECT amount, source, date_text, rate_text, timestamp FROM add_money_history WHERE agent_code = ? ORDER BY timestamp DESC LIMIT 20", (agent_code,))
        rows = cur.fetchall()
        
        if not rows:
            reply_and_delete(update, context, f"❌ Agent Code `{agent_code}` এর কোনো জমার হিস্ট্রি পাওয়া যায়নি।", parse_mode=ParseMode.MARKDOWN)
        else:
            msg = f"📋 **জমার হিস্ট্রি (Agent: `{agent_code}`)**\n(সর্বশেষ ২০টি)\n\n"
            for row in rows:
                amount, source, date_text, rate, ts = row
                time_str = datetime.fromtimestamp(ts).strftime("%d/%m/%y %I:%M %p")
                msg += (f"📅 তারিখ: {date_text}\n"
                        f"💰 পরিমাণ: ৳{amount}\n"
                        f"📝 কিসের টাকা: {source}\n"
                        f"💵 রেট: {rate}\n"
                        f"⏰ সিস্টেম টাইম: {time_str}\n"
                        f"-----------------------------\n")
            
            if len(msg) > 4000:
                chunks = [msg[i:i+4000] for i in range(0, len(msg), 4000)]
                for chunk in chunks:
                    update.message.reply_text(chunk, parse_mode=ParseMode.MARKDOWN)
            else:
                update.message.reply_text(msg, parse_mode=ParseMode.MARKDOWN)
                
    except Exception as e:
        logger.error(f"View history error: {e}")
        reply_and_delete(update, context, "❌ হিস্ট্রি দেখতে সমস্যা হয়েছে।")
        
    return cancel_and_show_menu(update, context)

